# Campus Life Express (CLX) Environment Variables
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DATABASE_URL=
SUPABASE_JWT_SECRET=
JWT_SECRET=
GAS_INTEGRATION_KEY=
