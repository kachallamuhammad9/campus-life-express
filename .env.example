# Campus Life Express (CLX) Environment Variables
PORT=3000
NODE_ENV=development
# Same-origin reverse-proxy API path by default. Set an HTTPS backend URL only
# when the static frontend and API are hosted on different origins.
VITE_API_BASE_URL=/api/v1
FRONTEND_URL=http://localhost:5173
DATABASE_URL=
DATABASE_SSL_CA=
SUPABASE_JWT_SECRET=
JWT_SECRET=
GAS_INTEGRATION_KEY=
GAS_WEBHOOK_URL=
GAS_WEBHOOK_SECRET=
EMAIL_PROVIDER=stub
EMAIL_FROM=notifications@campuslife.express
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=
PAYSTACK_API_BASE_URL=https://api.paystack.co

# API Rate Limiting Configuration
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100
ORDER_RATE_LIMIT_WINDOW_MS=600000
ORDER_RATE_LIMIT_MAX=60
PAYMENT_RATE_LIMIT_WINDOW_MS=600000
PAYMENT_RATE_LIMIT_MAX=60
RATE_LIMIT_DISABLED=false
