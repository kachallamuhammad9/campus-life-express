# CLX Backend Environment Variables
# Copy this file to .env and fill in the required values
# NEVER commit .env with real secrets to git

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:5173

# Database Configuration
# Supabase PostgreSQL Database URL
# Format: postgresql://user:password@host:port/database
# Example: postgresql://postgres:password@db.supabase.co:5432/postgres
DATABASE_URL=
# PEM certificate authority content for managed PostgreSQL providers that require it.
# Production connections always validate certificates.
DATABASE_SSL_CA=

# Google Apps Script (GAS) Integration
# Secret key required for inbound GAS reporting and automation requests
GAS_INTEGRATION_KEY=
# Outbound webhook URL for Google Apps Script Web App
GAS_WEBHOOK_URL=
# Shared secret for signing outbound webhook payloads via HMAC-SHA256
GAS_WEBHOOK_SECRET=

# Email Notification Provider (stub, smtp, console, webhook)
EMAIL_PROVIDER=stub
EMAIL_FROM=notifications@campuslife.express
# SMTP Configuration (Optional, when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Paystack Payments (test keys for sandbox; live keys only in production secret storage)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Provider callback endpoint, e.g. https://api.example.com/api/v1/payments/callback
PAYSTACK_CALLBACK_URL=
# Optional override for Paystack sandbox/proxy environments
PAYSTACK_API_BASE_URL=https://api.paystack.co

# API Rate Limiting Configuration (Express Rate Limit)
# Time windows in milliseconds and maximum requests per IP
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100
ORDER_RATE_LIMIT_WINDOW_MS=600000
ORDER_RATE_LIMIT_MAX=60
PAYMENT_RATE_LIMIT_WINDOW_MS=600000
PAYMENT_RATE_LIMIT_MAX=60
RATE_LIMIT_DISABLED=false

# Additional Notes:
# - Set DATABASE_URL to enable database connectivity
# - Use Supabase connection string for production/staging
# - For development, you can use a local PostgreSQL instance or Supabase
# - Keep .env file secret and out of version control
